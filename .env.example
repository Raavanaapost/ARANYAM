# Copy this file to .env.local and change what you need.
# Every setting is optional for local development.

# ---------------------------------------------------------------------------
# Website
# ---------------------------------------------------------------------------

# The public address of the site. Used to build links in emails.
APP_URL=http://localhost:3000

# Time zone for entering and showing event times.
APP_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Leave empty to use the built-in database
# (PGlite), which stores its files in .data/pglite. PGlite is great for trying
# Aranyam out; use PostgreSQL for a real community.
DATABASE_URL=
# DATABASE_URL=postgres://aranyam:aranyam@localhost:5432/aranyam
# DATABASE_POOL_SIZE=10

# Where PGlite keeps its files when DATABASE_URL is empty.
# PGLITE_DIR=.data/pglite

# Apply database migrations automatically when the server starts.
# AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# Joining the community
# ---------------------------------------------------------------------------

# New families must be welcomed in by a moderator before they can see anything.
REQUIRE_APPROVAL=true

# Families who join with an invite link from a member skip the moderator check.
INVITES_SKIP_APPROVAL=true

# Comma-separated emails that become admins as soon as they confirm their email.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# smtp: send real emails through SMTP_URL.
# dev:  keep emails in the database and show them at /en/dev/mailbox (development only).
# log:  write a note to the server log without the email's contents.
# Default: smtp when SMTP_URL is set, dev in development, log in production.
# EMAIL_TRANSPORT=

# For example smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM="Aranyam <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Trust the X-Forwarded-For header for rate limiting. Keep true behind a reverse
# proxy (nginx, Caddy, a hosting platform); set false if the app faces the
# internet directly.
TRUST_PROXY=true

# Keeps Server Actions working across restarts and multiple instances.
# Generate one with: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
